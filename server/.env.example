PORT=3001
APP_URL=http://localhost:3000
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=replace_with_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_with_business_account_id
WHATSAPP_VERIFY_TOKEN=choose_a_webhook_verify_token
WHATSAPP_RECIPIENT_PHONE=replace_with_recipient_phone

# Google Sheets logging (facultatif)
# 1. Créez un Service Account dans Google Cloud (IAM & Admin)
# 2. Téléchargez sa clé JSON, la clé privée (---BEGIN...END---) va dans GOOGLE_PRIVATE_KEY
# 3. Partagez votre Google Sheet (édition) avec l'adresse email du Service Account
# 4. GOOGLE_SHEET_ID = l'ID dans l'URL de la sheet (/spreadsheets/d/<ID>/edit)
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace_with_service_account_email
# Les \n doivent être littéraux dans le .env (pas de vrais retours à la ligne)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=replace_with_sheet_id
